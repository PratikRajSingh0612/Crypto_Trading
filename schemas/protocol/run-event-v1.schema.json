{"$defs":{"AdapterDiagnostic":{"additionalProperties":false,"description":"An adapter-reported diagnostic inside an event or manifest (plan 3.9).\n\nTrust class W inside a wire record, C after sanitization, one shape. It has no\nidentity, source component, correlation or timestamp: those are core-derived\nwhen a later stage persists it, and the envelope carries the instant. The code\nis in the adapter's namespace and the category one of the three an adapter may\nclaim.","properties":{"category":{"$ref":"#/$defs/AdapterDiagnosticCategory"},"causal_event_ids":{"items":{"$ref":"#/$defs/EventId"},"maxItems":32,"title":"Causal Event Ids","type":"array","uniqueItems":true},"details":{"additionalProperties":{"$ref":"#/$defs/DiagnosticDetailValue"},"maxProperties":64,"propertyNames":{"$ref":"#/$defs/DiagnosticDetailKey"},"title":"Details","type":"object"},"error_code":{"maxLength":128,"minLength":3,"pattern":"^(?:ADAPTER|ENGINE)(?:\\.[A-Z][A-Z0-9_]*)+(?![\\s\\S])","title":"Error Code","type":"string"},"message":{"maxLength":1024,"minLength":1,"title":"Message","type":"string"},"retriable":{"title":"Retriable","type":"boolean"},"severity":{"$ref":"#/$defs/DiagnosticSeverity"}},"required":["error_code","category","severity","message","retriable","details","causal_event_ids"],"title":"AdapterDiagnostic","type":"object"},"AdapterDiagnosticCategory":{"description":"Stage 6 plan section 3.9: the three categories an adapter may claim.","enum":["ENGINE_RUNTIME","ADAPTER_UNAVAILABILITY","COMPATIBILITY"],"title":"AdapterDiagnosticCategory","type":"string"},"ArtifactProducedPayload":{"additionalProperties":false,"description":"One declared candidate: a relative path, kind, media type, size and checksum.\n\nA lexically valid path is still untrusted; containment is Stage 7 and 9 work.","properties":{"artifact_kind":{"$ref":"#/$defs/NormalizedIdentifier"},"declared_sha256":{"$ref":"#/$defs/Sha256"},"declared_size_bytes":{"maximum":9007199254740991,"minimum":0,"title":"Declared Size Bytes","type":"integer"},"media_type":{"$ref":"#/$defs/MediaType"},"relative_path":{"$ref":"#/$defs/RelativeCandidatePath"}},"required":["relative_path","artifact_kind","media_type","declared_size_bytes","declared_sha256"],"title":"ArtifactProducedPayload","type":"object"},"BoundedDetailInteger":{"maximum":9223372036854775807,"minimum":-9223372036854775808,"type":"integer"},"CalendarValidUtcDateTime":{"allOf":[{"format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z(?![\\s\\S])","type":"string"},{"pattern":"^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T","type":"string"},{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{6})?Z","type":"string"}]},"ComparisonLevel":{"description":"Specification sections 25.1 to 25.3.\n\nLevel 2 requires Level 1, and Level 3 does not expect numerically identical\nresults. Member values sort in numeric order, so a sorted collection is also\ncanonically ordered.","enum":["LEVEL_1","LEVEL_2","LEVEL_3"],"title":"ComparisonLevel","type":"string"},"DiagnosticDetailKey":{"maxLength":128,"minLength":1,"type":"string"},"DiagnosticDetailString":{"maxLength":2048,"type":"string"},"DiagnosticDetailValue":{"anyOf":[{"$ref":"#/$defs/DiagnosticDetailString"},{"$ref":"#/$defs/BoundedDetailInteger"},{"type":"boolean"},{"items":{"$ref":"#/$defs/DiagnosticDetailValue"},"maxItems":64,"type":"array"},{"additionalProperties":{"$ref":"#/$defs/DiagnosticDetailValue"},"maxProperties":64,"propertyNames":{"$ref":"#/$defs/DiagnosticDetailKey"},"type":"object"},{"type":"null"}]},"DiagnosticPayload":{"additionalProperties":false,"description":"A recorded adapter diagnostic (plan 7.2).","properties":{"diagnostic":{"$ref":"#/$defs/AdapterDiagnostic"}},"required":["diagnostic"],"title":"DiagnosticPayload","type":"object"},"DiagnosticSeverity":{"enum":["INFO","WARNING","ERROR","CRITICAL"],"title":"DiagnosticSeverity","type":"string"},"EventId":{"pattern":"^evt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"FinalResultPayload":{"additionalProperties":false,"description":"A pointer to the adapter result manifest; never authoritative by itself.","properties":{"manifest_relative_path":{"$ref":"#/$defs/RelativeCandidatePath"},"semantic_status":{"$ref":"#/$defs/SemanticStatus"},"source_adapter_result_manifest_hash":{"$ref":"#/$defs/Sha256"}},"required":["manifest_relative_path","source_adapter_result_manifest_hash","semantic_status"],"title":"FinalResultPayload","type":"object"},"HeartbeatPayload":{"additionalProperties":false,"description":"Liveness evidence: a monotonic activity counter and the current phase.","properties":{"activity_counter":{"maximum":9007199254740991,"minimum":0,"title":"Activity Counter","type":"integer"},"phase":{"$ref":"#/$defs/NormalizedIdentifier"},"resource_observation":{"$ref":"#/$defs/ResourceObservation","title":"Resource Observation"}},"required":["activity_counter","phase"],"title":"HeartbeatPayload","type":"object"},"InvocationId":{"pattern":"^inv_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"MediaType":{"maxLength":255,"minLength":3,"pattern":"^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}(?![\\s\\S])","type":"string"},"NonNegativeDecimal":{"description":"Canonical non-negative Decimal string","maxLength":256,"pattern":"^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])(?![\\s\\S])","type":"string"},"NormalizedIdentifier":{"maxLength":128,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])","type":"string"},"ProgressPayload":{"additionalProperties":false,"description":"Informational progress; never used to infer success (specification 15.3).","properties":{"completed_units":{"maximum":9007199254740991,"minimum":0,"title":"Completed Units","type":"integer"},"percentage":{"$ref":"#/$defs/NonNegativeDecimal","title":"Percentage"},"phase":{"$ref":"#/$defs/NormalizedIdentifier"},"total_units":{"maximum":9007199254740991,"minimum":0,"title":"Total Units","type":"integer"}},"required":["phase","completed_units"],"title":"ProgressPayload","type":"object"},"ProtocolEventType":{"description":"Specification section 14.4: the six stdout event types, uppercase.","enum":["HEARTBEAT","PROGRESS","WARNING","DIAGNOSTIC","ARTIFACT_PRODUCED","FINAL_RESULT"],"title":"ProtocolEventType","type":"string"},"ProtocolWarning":{"additionalProperties":false,"description":"An adapter warning with its comparison-level effect (plan 3.9).","properties":{"impact":{"maxLength":1024,"minLength":1,"title":"Impact","type":"string"},"message":{"maxLength":1024,"minLength":1,"title":"Message","type":"string"},"prevented_comparison_levels":{"enum":[[],["LEVEL_1"],["LEVEL_2"],["LEVEL_3"],["LEVEL_1","LEVEL_2"],["LEVEL_1","LEVEL_3"],["LEVEL_2","LEVEL_3"],["LEVEL_1","LEVEL_2","LEVEL_3"]],"items":{"$ref":"#/$defs/ComparisonLevel"},"maxItems":3,"title":"Prevented Comparison Levels","type":"array","uniqueItems":true},"warning_code":{"maxLength":128,"minLength":3,"pattern":"^(?:ADAPTER|ENGINE)(?:\\.[A-Z][A-Z0-9_]*)+(?![\\s\\S])","title":"Warning Code","type":"string"}},"required":["warning_code","message","impact","prevented_comparison_levels"],"title":"ProtocolWarning","type":"object"},"RelativeCandidatePath":{"maxLength":512,"minLength":1,"pattern":"^(?!(?:[Aa][Uu][Xx]|[Cc][Oo][Nn]|[Nn][Uu][Ll]|[Pp][Rr][Nn]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|(?![\\s\\S])))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,253}[A-Za-z0-9_-])?(?:/(?!(?:[Aa][Uu][Xx]|[Cc][Oo][Nn]|[Nn][Uu][Ll]|[Pp][Rr][Nn]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|(?![\\s\\S])))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,253}[A-Za-z0-9_-])?){0,31}(?![\\s\\S])","type":"string"},"ResourceObservation":{"additionalProperties":false,"anyOf":[{"required":["resident_memory_bytes"]},{"required":["cpu_seconds"]}],"description":"An optional bounded resource observation on a heartbeat (plan 3.9).","properties":{"cpu_seconds":{"$ref":"#/$defs/NonNegativeDecimal","title":"Cpu Seconds"},"resident_memory_bytes":{"maximum":9007199254740991,"minimum":0,"title":"Resident Memory Bytes","type":"integer"}},"title":"ResourceObservation","type":"object"},"RunId":{"pattern":"^run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"SemanticStatus":{"description":"Specification section 11.5: the adapter's declared semantic status.","enum":["SUCCEEDED","SUCCEEDED_WITH_WARNINGS","FAILED","CANCELLED","TIMED_OUT","NOT_APPLICABLE","UNAVAILABLE"],"title":"SemanticStatus","type":"string"},"Sha256":{"pattern":"^[0-9a-f]{64}(?![\\s\\S])","type":"string"},"WarningPayload":{"additionalProperties":false,"description":"A recorded warning that must reappear in a run's manifest (plan 7.2).","properties":{"warning":{"$ref":"#/$defs/ProtocolWarning"}},"required":["warning"],"title":"WarningPayload","type":"object"}},"$id":"urn:crypto-lab:schema:protocol:run-event:1.0.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"if":{"properties":{"event_type":{"const":"HEARTBEAT"}},"required":["event_type"]},"then":{"properties":{"payload":{"$ref":"#/$defs/HeartbeatPayload"}}}},{"if":{"properties":{"event_type":{"const":"PROGRESS"}},"required":["event_type"]},"then":{"properties":{"payload":{"$ref":"#/$defs/ProgressPayload"}}}},{"if":{"properties":{"event_type":{"const":"WARNING"}},"required":["event_type"]},"then":{"properties":{"payload":{"$ref":"#/$defs/WarningPayload"}}}},{"if":{"properties":{"event_type":{"const":"DIAGNOSTIC"}},"required":["event_type"]},"then":{"properties":{"payload":{"$ref":"#/$defs/DiagnosticPayload"}}}},{"if":{"properties":{"event_type":{"const":"ARTIFACT_PRODUCED"}},"required":["event_type"]},"then":{"properties":{"payload":{"$ref":"#/$defs/ArtifactProducedPayload"}}}},{"if":{"properties":{"event_type":{"const":"FINAL_RESULT"}},"required":["event_type"]},"then":{"properties":{"payload":{"$ref":"#/$defs/FinalResultPayload"}}}}],"description":"The authoritative sanitized event (plan 3.9; specification 11.3 row in order).\n\nTrust class C: ``attempt_token_hash`` in the token's place, the sanitized payload,\nthe core receipt instant, the exact-byte ``wire_event_hash`` and the canonical\n``content_hash``, which must recompute over the ten content fields.","properties":{"attempt_token_hash":{"$ref":"#/$defs/Sha256"},"content_hash":{"$ref":"#/$defs/Sha256"},"event_id":{"$ref":"#/$defs/EventId"},"event_type":{"$ref":"#/$defs/ProtocolEventType"},"invocation_id":{"$ref":"#/$defs/InvocationId"},"payload":{"anyOf":[{"$ref":"#/$defs/HeartbeatPayload"},{"$ref":"#/$defs/ProgressPayload"},{"$ref":"#/$defs/WarningPayload"},{"$ref":"#/$defs/DiagnosticPayload"},{"$ref":"#/$defs/ArtifactProducedPayload"},{"$ref":"#/$defs/FinalResultPayload"}],"title":"Payload"},"protocol_version":{"const":"1.0.0","title":"Protocol Version","type":"string"},"received_at_utc":{"$ref":"#/$defs/CalendarValidUtcDateTime"},"run_id":{"$ref":"#/$defs/RunId"},"schema_version":{"const":"1.0.0","title":"Schema Version","type":"string"},"sequence":{"maximum":1000000,"minimum":1,"title":"Sequence","type":"integer"},"timestamp_utc":{"$ref":"#/$defs/CalendarValidUtcDateTime"},"wire_event_hash":{"$ref":"#/$defs/Sha256"}},"required":["schema_version","protocol_version","event_id","invocation_id","run_id","attempt_token_hash","sequence","event_type","timestamp_utc","payload","received_at_utc","wire_event_hash","content_hash"],"title":"RunEvent","type":"object"}
