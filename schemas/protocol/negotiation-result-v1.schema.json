{"$defs":{"ErrorCode":{"maxLength":128,"minLength":3,"pattern":"^[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)+(?![\\s\\S])","type":"string"},"NegotiationOutcome":{"description":"Specification section 14.2: negotiation selects or fails closed.","enum":["NEGOTIATED","FAILED"],"title":"NegotiationOutcome","type":"string"},"NormalizedIdentifier":{"maxLength":128,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])","type":"string"},"SemanticVersion":{"maxLength":64,"minLength":5,"pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])","type":"string"},"SupportedSchemaVersion":{"additionalProperties":false,"properties":{"schema_name":{"$ref":"#/$defs/NormalizedIdentifier"},"schema_version":{"$ref":"#/$defs/SemanticVersion"}},"required":["schema_name","schema_version"],"title":"SupportedSchemaVersion","type":"object"}},"$id":"urn:crypto-lab:schema:protocol:negotiation-result:1.0.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"if":{"properties":{"outcome":{"const":"NEGOTIATED"}},"required":["outcome"]},"then":{"properties":{"reason_codes":{"maxItems":0}},"required":["selected_protocol_version","selected_schema_versions","selected_vocabulary_version"]}},{"if":{"properties":{"outcome":{"const":"FAILED"}},"required":["outcome"]},"then":{"not":{"anyOf":[{"required":["selected_protocol_version"]},{"required":["selected_schema_versions"]},{"required":["selected_vocabulary_version"]}]},"properties":{"reason_codes":{"minItems":1}}}}],"description":"Deterministic protocol, schema and vocabulary selection (plan 3.8).\n\nSpecification 11.3's row plus ``adapter_version`` and the 14.2 policy version.\nTrust class C. ``NEGOTIATED`` carries every selected value, each a member of its\ncandidate intersection, and no reason code; ``FAILED`` carries no selected value\nand at least one reason code. ``reason_codes`` is the declared deviation from\nthe 11.3 field name ``diagnostics`` (module docstring).","proper