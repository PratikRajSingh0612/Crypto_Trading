{"$defs":{"AdapterDiagnostic":{"additionalProperties":false,"description":"An adapter-reported diagnostic inside an event or manifest (plan 3.9).\n\nTrust class W inside a wire record, C after sanitization, one shape. It has no\nidentity, source component, correlation or timestamp: those are core-derived\nwhen a later stage persists it, and the envelope carries the instant. The code\nis in the adapter's namespace and the category one of the three an adapter may\nclaim.","properties":{"category":{"$ref":"#/$defs/AdapterDiagnosticCategory"},"causal_event_ids":{"items":{"$ref":"#/$defs/EventId"},"maxItems":32,"title":"Causal Event Ids","type":"array","uniqueItems":true},"details":{"additionalProperties":{"$ref":"#/$defs/DiagnosticDetailValue"},"maxProperties":64,"propertyNames":{"$ref":"#/$defs/DiagnosticDetailKey"},"title":"Details","type":"object"},"error_code":{"maxLength":128,"minLength":3,"pattern":"^(?:ADAPTER|ENGINE)(?:\\.[A-Z][A-Z0-9_]*)+(?![\\s\\S])","title":"Error Code","type":"string"},"message":{"maxLength":1024,"minLength":1,"title":"Message","type":"string"},"retriable":{"title":"Retriable","type":"boolean"},"severity":{"$ref":"#/$defs/DiagnosticSeverity"}},"required":["error_code","category","severity","message","retriable","details","causal_event_ids"],"title":"AdapterDiagnostic","type":"object"},"AdapterDiagnosticCategory":{"description":"Stage 6 plan section 3.9: the three categories an adapter may claim.","enum":["ENGINE_RUNTIME","ADAPTER_UNAVAILABILITY","COMPATIBILITY"],"title":"AdapterDiagnosticCategory","type":"string"},"AdapterIdentity":{"additionalProperties":false,"description":"A pinned adapter name and version, plan section 3.5.","properties":{"adapter_name":{"$ref":"#/$defs/NormalizedIdentifier"},"adapter_version":{"$ref":"#/$defs/SemanticVersion"}},"required":["adapter_name","adapter_version"],"title":"AdapterIdentity","type":"object"},"AdapterManifestId":{"pattern":"^amf_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"ApproximationId":{"pattern":"^appx_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"AttemptToken":{"maxLength":1024,"minLength":32,"pattern":"^[A-Za-z0-9_-]+(?![\\s\\S])","type":"string"},"BoundedDetailInteger":{"maximum":9223372036854775807,"minimum":-9223372036854775808,"type":"integer"},"CalendarValidUtcDateTime":{"allOf":[{"format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z(?![\\s\\S])","type":"string"},{"pattern":"^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T","type":"string"},{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{6})?Z","type":"string"}]},"CandidateArtifactDeclaration":{"additionalProperties":false,"description":"One declared candidate in the manifest: the five ``ArtifactProducedPayload``\nfields (plan 3.10; trust class W). A lexically valid path is still untrusted.","properties":{"artifact_kind":{"$ref":"#/$defs/NormalizedIdentifier"},"declared_sha256":{"$ref":"#/$defs/Sha256"},"declared_size_bytes":{"maximum":9007199254740991,"minimum":0,"title":"Declared Size Bytes","type":"integer"},"media_type":{"$ref":"#/$defs/MediaType"},"relative_path":{"$ref":"#/$defs/RelativeCandidatePath"}},"required":["relative_path","artifact_kind","media_type","declared_size_bytes","declared_sha256"],"title":"CandidateArtifactDeclaration","type":"object"},"CandidateMetric":{"additionalProperties":false,"allOf":[{"if":{"properties":{"value_status":{"const":"DEFINED"}},"required":["value_status"]},"then":{"required":["value"]}},{"if":{"properties":{"value_status":{"const":"UNDEFINED"}},"required":["value_status"]},"then":{"not":{"required":["value"]}}}],"description":"A declared normalized metric (plan 3.10); not the deferred ``MetricValue``.\n\nA missing or undefined value uses the explicit ``value_status`` rather than\n``NaN`` (specification 11.3): ``DEFINED`` exactly when ``value`` is present.","properties":{"comparison_level":{"$ref":"#/$defs/ComparisonLevel"},"methodology_version":{"$ref":"#/$defs/SemanticVersion"},"metric_name":{"$ref":"#/$defs/NormalizedIdentifier"},"unit":{"$ref":"#/$defs/NormalizedIdentifier"},"value":{"$ref":"#/$defs/CanonicalDecimal","title":"Value"},"value_status":{"enum":["DEFINED","UNDEFINED"],"title":"Value Status","type":"string"}},"required":["metric_name","value_status","unit","methodology_version","comparison_level"],"title":"CandidateMetric","type":"object"},"CanonicalDecimal":{"description":"Canonical finite Decimal string","maxLength":256,"pattern":"^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]|-[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-0\\.[0-9]*[1-9])(?![\\s\\S])","type":"string"},"ComparisonLevel":{"description":"Specification sections 25.1 to 25.3.\n\nLevel 2 requires Level 1, and Level 3 does not expect numerically identical\nresults. Member values sort in numeric order, so a sorted collection is also\ncanonically ordered.","enum":["LEVEL_1","LEVEL_2","LEVEL_3"],"title":"ComparisonLevel","type":"string"},"DiagnosticDetailKey":{"maxLength":128,"minLength":1,"type":"string"},"DiagnosticDetailString":{"maxLength":2048,"type":"string"},"DiagnosticDetailValue":{"anyOf":[{"$ref":"#/$defs/DiagnosticDetailString"},{"$ref":"#/$defs/BoundedDetailInteger"},{"type":"boolean"},{"items":{"$ref":"#/$defs/DiagnosticDetailValue"},"maxItems":64,"type":"array"},{"additionalProperties":{"$ref":"#/$defs/DiagnosticDetailValue"},"maxProperties":64,"propertyNames":{"$ref":"#/$defs/DiagnosticDetailKey"},"type":"object"},{"type":"null"}]},"DiagnosticSeverity":{"enum":["INFO","WARNING","ERROR","CRITICAL"],"title":"DiagnosticSeverity","type":"string"},"EngineIdentity":{"additionalProperties":false,"description":"A pinned engine name and version, plan section 3.5.","properties":{"engine_name":{"$ref":"#/$defs/NormalizedIdentifier"},"engine_version":{"$ref":"#/$defs/SemanticVersion"}},"required":["engine_name","engine_version"],"title":"EngineIdentity","type":"object"},"EventId":{"pattern":"^evt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"ExperimentId":{"pattern":"^exp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"InvocationId":{"pattern":"^inv_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"LogicalSlotId":{"pattern":"^slot_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"MediaType":{"maxLength":255,"minLength":3,"pattern":"^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}(?![\\s\\S])","type":"string"},"NegotiatedVersions":{"additionalProperties":false,"description":"The versions negotiation chose, pinned in the request (plan 3.6, 5.2).\n\nSpecification 14.2: \"chosen versions are pinned in the request\". Exactly the\nfive negotiable schema names, once each, sorted (published exactly as\n``prefixItems`` by ``_negotiated_schema_extra``); the protocol version is the\nsingle literal the core supports. The per-name ``schema_version`` values are\ndeliberately constrained only as ``SemanticVersion``: they are negotiation's\nselection (Task 3) from the adapter's declared lists, not a rule of this\nrecord. A nested value object.","properties":{"capability_vocabulary_version":{"maxLength":32,"pattern":"^capabilities/v[1-9][0-9]*(?![\\s\\S])","title":"Capability Vocabulary Version","type":"string"},"protocol_version":{"const":"1.0.0","title":"Protocol Version","type":"string"},"schema_versions":{"items":{"$ref":"#/$defs/SupportedSchemaVersion"},"maxItems":5,"minItems":5,"prefixItems":[{"allOf":[{"$ref":"#/$defs/SupportedSchemaVersion"},{"properties":{"schema_name":{"const":"protocol.adapter-command-request-envelope"}},"required":["schema_name"]}]},{"allOf":[{"$ref":"#/$defs/SupportedSchemaVersion"},{"properties":{"schema_name":{"const":"protocol.adapter-descriptor"}},"required":["schema_name"]}]},{"allOf":[{"$ref":"#/$defs/SupportedSchemaVersion"},{"properties":{"schema_name":{"const":"protocol.adapter-result-manifest"}},"required":["schema_name"]}]},{"allOf":[{"$ref":"#/$defs/SupportedSchemaVersion"},{"properties":{"schema_name":{"const":"protocol.adapter-validation-result"}},"required":["schema_name"]}]},{"allOf":[{"$ref":"#/$defs/SupportedSchemaVersion"},{"properties":{"schema_name":{"const":"protocol.protocol-event-envelope"}},"required":["schema_name"]}]}],"title":"Schema Versions","type":"array","uniqueItems":true}},"required":["protocol_version","schema_versions","capability_vocabulary_version"],"title":"NegotiatedVersions","type":"object"},"NormalizedIdentifier":{"maxLength":128,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])","type":"string"},"ProtocolWarning":{"additionalProperties":false,"description":"An adapter warning with its comparison-level effect (plan 3.9).","properties":{"impact":{"maxLength":1024,"minLength":1,"title":"Impact","type":"string"},"message":{"maxLength":1024,"minLength":1,"title":"Message","type":"string"},"prevented_comparison_levels":{"enum":[[],["LEVEL_1"],["LEVEL_2"],["LEVEL_3"],["LEVEL_1","LEVEL_2"],["LEVEL_1","LEVEL_3"],["LEVEL_2","LEVEL_3"],["LEVEL_1","LEVEL_2","LEVEL_3"]],"items":{"$ref":"#/$defs/ComparisonLevel"},"maxItems":3,"title":"Prevented Comparison Levels","type":"array","uniqueItems":true},"warning_code":{"maxLength":128,"minLength":3,"pattern":"^(?:ADAPTER|ENGINE)(?:\\.[A-Z][A-Z0-9_]*)+(?![\\s\\S])","title":"Warning Code","type":"string"}},"required":["warning_code","message","impact","prevented_comparison_levels"],"title":"ProtocolWarning","type":"object"},"RelativeCandidatePath":{"maxLength":512,"minLength":1,"pattern":"^(?!(?:[Aa][Uu][Xx]|[Cc][Oo][Nn]|[Nn][Uu][Ll]|[Pp][Rr][Nn]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|(?![\\s\\S])))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,253}[A-Za-z0-9_-])?(?:/(?!(?:[Aa][Uu][Xx]|[Cc][Oo][Nn]|[Nn][Uu][Ll]|[Pp][Rr][Nn]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|(?![\\s\\S])))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,253}[A-Za-z0-9_-])?){0,31}(?![\\s\\S])","type":"string"},"RunId":{"pattern":"^run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])","type":"string"},"RunProvenance":{"additionalProperties":false,"description":"The specification 10.3 provenance the manifest echoes (plan 3.10; nested).\n\nEvery value is one the request handed the adapter, so the reconciler compares\neach against its own inputs (plan 9.2 check 5).","properties":{"adapter":{"$ref":"#/$defs/AdapterIdentity"},"attempt_number":{"maximum":5,"minimum":1,"title":"Attempt Number","type":"integer"},"comparison_level":{"$ref":"#/$defs/ComparisonLevel"},"configuration_hash":{"$ref":"#/$defs/Sha256"},"dataset_version_hash":{"$ref":"#/$defs/Sha256"},"engine":{"$ref":"#/$defs/EngineIdentity"},"experiment_spec_hash":{"$ref":"#/$defs/Sha256"},"logical_slot_id":{"$ref":"#/$defs/LogicalSlotId"},"negotiated_versions":{"$ref":"#/$defs/NegotiatedVersions"},"request_hash":{"$ref":"#/$defs/Sha256"},"strategy_version_hash":{"$ref":"#/$defs/Sha256"}},"required":["experiment_spec_hash","request_hash","strategy_version_hash","dataset_version_hash","configuration_hash","adapter","engine","negotiated_versions","comparison_level","logical_slot_id","attempt_number"],"title":"RunProvenance","type":"object"},"SemanticStatus":{"description":"Specification section 11.5: the adapter's declared semantic status.","enum":["SUCCEEDED","SUCCEEDED_WITH_WARNINGS","FAILED","CANCELLED","TIMED_OUT","NOT_APPLICABLE","UNAVAILABLE"],"title":"SemanticStatus","type":"string"},"SemanticVersion":{"maxLength":64,"minLength":5,"pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])","type":"string"},"Sha256":{"pattern":"^[0-9a-f]{64}(?![\\s\\S])","type":"string"},"SupportedSchemaVersion":{"additionalProperties":false,"properties":{"schema_name":{"$ref":"#/$defs/NormalizedIdentifier"},"schema_version":{"$ref":"#/$defs/SemanticVersion"}},"required":["schema_name","schema_version"],"title":"SupportedSchemaVersion","type":"object"}},"$id":"urn:crypto-lab:schema:protocol:adapter-result-manifest:1.0.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"if":{"properties":{"semantic_status":{"const":"SUCCEEDED"}},"required":["semantic_status"]},"then":{"properties":{"warnings":{"maxItems":0}}}},{"if":{"properties":{"semantic_status":{"const":"SUCCEEDED_WITH_WARNINGS"}},"required":["semantic_status"]},"then":{"properties":{"warnings":{"minItems":1}}}},{"if":{"properties":{"semantic_status":{"enum":["FAILED","CANCELLED","TIMED_OUT","NOT_APPLICABLE","UNAVAILABLE"]}},"required":["semantic_status"]},"then":{"properties":{"candidate_artifacts":{"maxItems":0},"diagnostics":{"minItems":1}}}}],"description":"The untrusted ``run`` result file (plan 3.10; specification 11.3 row in order).\n\nTrust class W and token-bearing: the raw token is required, hidden from ``repr``\nand never persisted; ``sanitize_result_manifest`` builds the core representation.\nCompletion does not precede start; declarations are unique on ``relative_path``\nand metrics on ``metric_name``; approximations are sorted identities; the status\ncoupling holds.","properties":{"adapter_manifest_id":{"$ref":"#/$defs/AdapterManifestId"},"approximations":{"items":{"$ref":"#/$defs/ApproximationId"},"maxItems":64,"title":"Approximations","type":"array","uniqueItems":true},"attempt_token":{"$ref":"#/$defs/AttemptToken"},"candidate_artifacts":{"items":{"$ref":"#/$defs/CandidateArtifactDeclaration"},"maxItems":256,"title":"Candidate Artifacts","type":"array","uniqueItems":true},"candidate_metrics":{"items":{"$ref":"#/$defs/CandidateMetric"},"maxItems":256,"title":"Candidate Metrics","type":"array","uniqueItems":true},"completed_at_utc":{"$ref":"#/$defs/CalendarValidUtcDateTime"},"diagnostics":{"items":{"$ref":"#/$defs/AdapterDiagnostic"},"maxItems":64,"title":"Diagnostics","type":"array"},"experiment_id":{"$ref":"#/$defs/ExperimentId"},"invocation_id":{"$ref":"#/$defs/InvocationId"},"protocol_version":{"const":"1.0.0","title":"Protocol Version","type":"string"},"provenance":{"$ref":"#/$defs/RunProvenance"},"run_id":{"$ref":"#/$defs/RunId"},"schema_version":{"const":"1.0.0","title":"Schema Version","type":"string"},"semantic_status":{"$ref":"#/$defs/SemanticStatus"},"started_at_utc":{"$ref":"#/$defs/CalendarValidUtcDateTime"},"warnings":{"items":{"$ref":"#/$defs/ProtocolWarning"},"maxItems":64,"title":"Warnings","type":"array"}},"required":["schema_version","protocol_version","adapter_manifest_id","experiment_id","run_id","invocation_id","attempt_token","semantic_status","started_at_utc","completed_at_utc","provenance","candidate_artifacts","candidate_metrics","diagnostics","warnings","approximations"],"title":"AdapterResultManifest","type":"object"}
