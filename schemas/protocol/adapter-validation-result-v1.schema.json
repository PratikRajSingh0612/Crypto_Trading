{"$defs":{"AdapterDiagnostic":{"additionalProperties":false,"description":"An adapter-reported diagnostic inside an event or manifest (plan 3.9).\n\nTrust class W inside a wire record, C after sanitization, one shape. It has no\nidentity, source component, correlation or timestamp: those are core-derived\nwhen a later stage persists it, and the envelope carries the instant. The code\nis in the adapter's namespace and the category one of the three an adapter may\nclaim.","properties":{"category":{"$ref":"#/$defs/AdapterDiagnosticCategory"},"causal_event_ids":{"items":{"$ref":"#/$defs/EventId"},"maxItems":32,"title":"Causal Event Ids","type":"array","uniqueItems":true},"details":{"additionalProperties":{"$ref":"#/$defs/DiagnosticDetailValue"},"maxProperties":64,"propertyNames":{"$ref":"#/$defs/DiagnosticDetailKey"},"title":"Details","type":"object"},"error_code":{"maxLength":128,"minLength":3,"pattern":"^(?:ADAPTER|ENGINE)(?:\\.[A-Z][A-Z0-9_]*)+(?![\\s\\S])","title":"Error Code","type":"string"},"message":{"maxLength":1024,"minLength":1,"title":"Message","type":"string"},"retriable":{"title":"Retriable","type":"boolean"},"severity":{"$ref":"#/$defs/DiagnosticSeverity"}},"required":["error_code","category","severity","message","retriable","details","causal_event_ids"],"title":"AdapterDiagnostic","type":"object"},"AdapterDiagnosticCategory":{"description":"Stage 6 plan section 3.9: the three categories an adapter may claim.","enum":["ENGINE_RUNTIME","ADAPTER_UNAVAILABILITY","COMPATIBILITY"],"title":"AdapterDiagnosticCategory","type":"string"},"BoundedDetailInteger":{"maximum":9223372036854775807,"minimum":-9223372036854775808,"type":"integer"},"CalendarValidUtcDateTime":{"allOf":[{"format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z(?![\\s\\S])","type":"string"},{"pattern":"^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[