{"$defs":{"AssetCode":{"maxLength":32,"minLength":1,"pattern":"^[A-Z][A-Z0-9]*(?:[._-][A-Z0-9]+)*(?![\\s\\S])","type":"string"},"InstrumentId":{"allOf":[{"pattern":"^[A-Z][A-Z0-9]*(?:[._-][A-Z0-9]+)*:[A-Z][A-Z0-9]*(?:[._-][A-Z0-9]+)*/[A-Z][A-Z0-9]*(?:[._-][A-Z0-9]+)*:(?:SPOT|MARGIN|FUTURES|EQUITIES)(?![\\s\\S])"},{"pattern":"^[A-Z][A-Z0-9._-]{0,31}:[A-Z][A-Z0-9._-]{0,31}/[A-Z][A-Z0-9._-]{0,31}:(?:SPOT|MARGIN|FUTURES|EQUITIES)(?![\\s\\S])"}],"maxLength":107,"minLength":10,"type":"string"},"MarketType":{"description":"Canonical market vocabulary available for descriptor compatibility.","enum":["SPOT","MARGIN","FUTURES","EQUITIES"],"title":"MarketType","type":"string"}},"$id":"urn:crypto-lab:schema:domain:instrument-ref:1.0.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"base_asset":{"$ref":"#/$defs/AssetCode"},"canonical_id":{"$ref":"#/$defs/InstrumentId"},"market_type":{"$ref":"#/$defs/MarketType"},"quote_asset":{"$ref":"#/$defs/AssetCode"},"schema_version":{"const":"1.0.0","title":"Schema Version","type":"string"},"venue":{"$ref":"#/$defs/AssetCode"}},"required":["schema_version","canonical_id","venue","base_asset","quote_asset","market_type"],"title":"InstrumentRef","type":"object"}
