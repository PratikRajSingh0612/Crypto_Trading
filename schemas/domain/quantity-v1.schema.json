{"$defs":{"AssetCode":{"maxLength":32,"minLength":1,"pattern":"^[A-Z][A-Z0-9]*(?:[._-][A-Z0-9]+)*(?![\\s\\S])","type":"string"},"InstrumentId":{"allOf":[{"pattern":"^[A-Z][A-Z0-9]*(?:[._-][A-Z0-9]+)*:[A-Z][A-Z0-9]*(?:[._-][A-Z0-9]+)*/[A-Z][A-Z0-9]*(?:[._-][A-Z0-9]+)*:(?:SPOT|MARGIN|FUTURES|EQUITIES)(?![\\s\\S])"},{"pattern":"^[A-Z][A-Z0-9._-]{0,31}:[A-Z][A-Z0-9._-]{0,31}/[A-Z][A-Z0-9._-]{0,31}:(?:SPOT|MARGIN|FUTURES|EQUITIES)(?![\\s\\S])"}],"maxLength":107,"minLength":10,"type":"string"},"NonNegativeDecimal":{"description":"Canonical non-negative Decimal string","maxLength":256,"pattern":"^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])(?![\\s\\S])","type":"string"}},"$id":"urn:crypto-lab:schema:domain:quantity:1.0.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"base_asset":{"$ref":"#/$defs/AssetCode"},"instrument_id":{"$ref":"#/$defs/InstrumentId"},"schema_version":{"const":"1.0.0","title":"Schema Version","type":"string"},"value":{"$ref":"#/$defs/NonNegativeDecimal"}},"required":["schema_version","instrument_id","base_asset","value"],"title":"Quantity","type":"object"}
